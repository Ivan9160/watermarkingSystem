// use prisma-8

enum BatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ImageJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Organization {
  id        String @id @default(cuid(2))
  allegroUserId  Int @unique @map("allegro_user_id")
  name      String

  batches Batch[]


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  @@map("organizations")
}
model Batch {
  id              String @id @default(cuid(2))
  organizationId  String @map("organization_id")
  watermarkConfig Json @map("watermark_config")
  status          BatchStatus @default(QUEUED)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")
  completedAt     DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ImageJob[]

  @@index([organizationId, status])
  @@map("batches")
}

model ImageJob {
  id           String @id @default(cuid(2))
  batchId      String @map("batch_id")
  sourceUrl    String @map("source_url")
  outputUrl    String? @map("output_url")
  productOfferId  String @map("product_offer_id")
  imageIndex  Int @map("image_index")
  storageKey   String @unique @map("storage_key")
  status       ImageJobStatus @default(PENDING)
  errorMessage String? @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  processedAt  DateTime? @map("processed_at")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@map("image_jobs")
}
